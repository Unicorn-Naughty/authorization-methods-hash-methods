generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  posts Post[]
}

model Post {
  id String @id @default(uuid())
  title String
  text String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt 
  userId String
  user User @relation(fields: [userId], references: [id])
}